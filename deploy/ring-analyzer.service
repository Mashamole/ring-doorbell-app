[Unit]
Description=Ring Doorbell Video Analyzer (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Update User/WorkingDirectory if your Pi username or install path differs
User=pi
Group=pi
WorkingDirectory=/home/pi/Ring-doorbell-app
EnvironmentFile=/home/pi/Ring-doorbell-app/.env
ExecStart=/home/pi/Ring-doorbell-app/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8080 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
